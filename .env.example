# Copie este archivo como .env y complete los valores. NUNCA suba .env al repositorio.

# --- IA (Anthropic Claude) ---
# Obtenga la clave en https://console.anthropic.com/ -> API Keys
ANTHROPIC_API_KEY=
# Modelo (opcional). Por defecto: claude-sonnet-5-5
ANTHROPIC_MODEL=claude-sonnet-5-5
# Tiempo máximo de espera de la IA en segundos (opcional)
IA_TIMEOUT_SEGUNDOS=30

# --- Base de datos (opcional) ---
# Por defecto: data/campus.db
# DB_PATH=data/campus.db
